<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#60A917</item>
        <item name="android:colorPrimaryDark">#FFFFFF</item>
        <item name="android:colorAccent">#60A917</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">#FFFFFF</item>
    </style>
    <style name="AppDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#60A917</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:colorAccent">#60A917</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">#000000</item>
    </style>
    <style name="AppBlack" parent="AppDark">
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:statusBarColor">#000000</item>
    </style>
    <!-- Small pop-up windows over other apps (save prompt). -->
    <style name="AppTranslucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#60A917</item>
        <item name="android:colorPrimary">#60A917</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="AppTranslucentDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#60A917</item>
        <item name="android:colorPrimary">#60A917</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Windows Phone message boxes: square, full-width, no rounded card. -->
    <style name="MetroDialogDark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@color/metro_dialog_dark</item>
        <item name="android:colorAccent">#60A917</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@style/FluentDialogAnim</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
    </style>
    <style name="MetroDialogLight" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/metro_dialog_light</item>
        <item name="android:colorAccent">#60A917</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@style/FluentDialogAnim</item>
    </style>
    <!-- Message boxes drop down from the top, the app-bar menu rises from the bottom (Windows Phone). -->
    <style name="MetroTopAnim">
        <item name="android:windowEnterAnimation">@anim/metro_top_in</item>
        <item name="android:windowExitAnimation">@anim/metro_top_out</item>
    </style>
    <style name="MetroBottomAnim">
        <item name="android:windowEnterAnimation">@anim/metro_bottom_in</item>
        <item name="android:windowExitAnimation">@anim/metro_bottom_out</item>
    </style>
    <!-- Fluent ContentDialog: scales down slightly while fading in. -->
    <style name="FluentDialogAnim">
        <item name="android:windowEnterAnimation">@anim/fluent_in</item>
        <item name="android:windowExitAnimation">@anim/fluent_out</item>
    </style>
</resources>
