{
  "manifest_version": 3,
  "name": "GroveVault",
  "short_name": "GroveVault",
  "version": "1.0.0",
  "description": "Log in with your Grove Vault passwords. Talks only to the Grove Vault app on this phone, encrypted.",
  "icons": {"48": "icon48.png", "128": "icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "GroveVault", "default_icon": {"48": "icon48.png"}},
  "background": {"service_worker": "bg.js"},
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["cs.js"], "run_at": "document_idle", "all_frames": true}]
}
